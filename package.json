{
  "name": "tripo-studio-plugin",
  "version": "0.3.12",
  "description": "Codex plugin for Tripo Studio member-account image and 3D workflows, shared model/image asset groups, persistent headless auth, durable tasks and provenance.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/GrinZero/tripo-studio-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GrinZero/tripo-studio-plugin.git"
  },
  "bugs": "https://github.com/GrinZero/tripo-studio-plugin/issues",
  "keywords": [
    "codex",
    "codex-plugin",
    "mcp",
    "tripo",
    "3d"
  ],
  "bin": {
    "tripo-studio": "mcp/bootstrap.mjs"
  },
  "files": [
    ".codex-plugin/plugin.json",
    ".mcp.json",
    "mcp/",
    "dist/",
    "ui/*.html",
    "ui/*.png",
    "ui/*.svg",
    "skills/",
    "scripts/blender-worker.py",
    "docs/USAGE.md",
    "docs/CONFIGURATION.md",
    "docs/DISTRIBUTION.md",
    "docs/images/*.png",
    "TOOL_INVENTORY.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "node scripts/build.mjs",
    "install:local": "node scripts/install-local.mjs",
    "prepack": "node scripts/build.mjs && node scripts/check-distribution.mjs",
    "prepare": "husky",
    "version": "node scripts/sync-version.mjs",
    "check:distribution": "node scripts/check-distribution.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm run lint && pnpm run format:check && pnpm run check:distribution",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "serve": "node mcp/bootstrap.mjs",
    "serve:src": "node src/server.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/lib-storage": "3.1147.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@google/model-viewer": "4.4.0",
    "@imagemagick/magick-wasm": "0.0.44",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/mcp-extensions": "0.1.0",
    "@smithy/node-http-handler": "4.12.1",
    "esbuild": "^0.25.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "three": "0.183.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
