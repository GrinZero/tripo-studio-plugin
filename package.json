{
  "name": "tripo-studio-plugin",
  "version": "0.3.3",
  "description": "Codex plugin for Tripo Studio member-account image and 3D workflows, shared model/image asset groups, persistent headless auth, durable tasks and provenance.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "serve": "node mcp/bootstrap.mjs",
    "serve:src": "node src/server.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@openai/mcp-extensions": "^0.1.0",
    "fflate": "^0.8.3",
    "sharp": "^0.35.5",
    "three": "^0.180.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
